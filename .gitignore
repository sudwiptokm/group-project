# Python virtual environment
venv/
.venv/

# Python cache
__pycache__/
*.pyc

# macOS
.DS_Store

# Run outputs (regenerated by run_experiment.sh / train.py / tune.py / baseline.py)
models/
logs/
params/
calibration_result.txt

# Results scp'd down from the cloud box (cloud_results/ cloud_logs/ cloud_models/ ...)
cloud_*/

# Generated result figures (regenerated by plots.py)
results/*.png

# Per-run output of the static-green sweep — ~1 MB of tripinfo per run, and
# regenerated by analysis/static_timing.py. The aggregate the results cite,
# analysis/static_sweep.csv, IS tracked.
analysis/static_logs/

# Local crash-insurance snapshots + helper (not part of the experiment)
backups/
backup_loop.sh

# Stage-1 peak artifacts, moved aside 2026-08-12 so resume logic cannot reuse
# models trained against the pre-fix reward (see docs/FINDINGS_2026-08-12.md)
archive_stage1_peak/

# Presentation media (large, regenerable by presentation/capture_demo*.py)
presentation/*.mp4
presentation/*.pdf

# Per-run output of the actuated-controller probe (same reasoning as static_logs)
analysis/actuated_logs/
