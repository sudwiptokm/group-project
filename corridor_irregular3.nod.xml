<?xml version="1.0" encoding="UTF-8"?>
<!-- Third irregular-spacing variant of corridor.nod.xml (SP10, follow-up to
     SP8's corridor_irregular.net.xml). Same 3-signal arterial topology
     (C1,C2,C3 on y=0), same skew direction as SP8 (long block first, short
     block second) but MODERATE asymmetry: 300m then 100m, vs SP8's extreme
     600m then 100m (vs the regular 200m/200m). SP8's own caveat section asked
     whether idqn's win margin is sensitive to how extreme the asymmetry is;
     this variant sits partway between the regular net (no skew) and SP8's
     net (maximal skew tested so far) to see if the margin scales
     monotonically or is closer to a step function. Reuses corridor.edg.xml
     verbatim (edges reference node ids, not coordinates), same as
     corridor_irregular.nod.xml. -->
<nodes>
    <node id="W"  x="-200" y="0"    type="priority"/>
    <node id="C1" x="0"    y="0"    type="traffic_light"/>
    <node id="C2" x="300"  y="0"    type="traffic_light"/>
    <node id="C3" x="400"  y="0"    type="traffic_light"/>
    <node id="E"  x="600"  y="0"    type="priority"/>

    <node id="N1" x="0"    y="200"  type="priority"/>
    <node id="S1" x="0"    y="-200" type="priority"/>
    <node id="N2" x="300"  y="200"  type="priority"/>
    <node id="S2" x="300"  y="-200" type="priority"/>
    <node id="N3" x="400"  y="200"  type="priority"/>
    <node id="S3" x="400"  y="-200" type="priority"/>
</nodes>
