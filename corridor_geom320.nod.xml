<?xml version="1.0" encoding="UTF-8"?>
<!-- SP13 geometry dose-response sweep point r=0.80 (analysis/
     build_geometry_sweep_nets.py). Same 3-signal arterial topology as
     corridor.nod.xml, C1@0/C3@400 fixed (same total span), only C2's
     position varies: nominal 320m/80m instead of the regular 200m/200m.
     Reuses corridor.edg.xml verbatim (edges reference node ids, not
     coordinates), same as corridor_irregular3.nod.xml. -->
<nodes>
    <node id="W"  x="-200" y="0"    type="priority"/>
    <node id="C1" x="0"    y="0"    type="traffic_light"/>
    <node id="C2" x="320"  y="0"    type="traffic_light"/>
    <node id="C3" x="400"  y="0"    type="traffic_light"/>
    <node id="E"  x="600"  y="0"    type="priority"/>

    <node id="N1" x="0"    y="200"  type="priority"/>
    <node id="S1" x="0"    y="-200" type="priority"/>
    <node id="N2" x="320"  y="200"  type="priority"/>
    <node id="S2" x="320"  y="-200" type="priority"/>
    <node id="N3" x="400"  y="200"  type="priority"/>
    <node id="S3" x="400"  y="-200" type="priority"/>
</nodes>
